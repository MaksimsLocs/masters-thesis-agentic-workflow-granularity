      ],
      "id": "bce02eef-304c-4f9a-969c-2f8d375d5c5f",
      "name": "Clean HTML from Description"
    },
    {
      "parameters": {
        "jsCode": "// Combine item 0 (data) and item 1 (output)\nconst arr = $items().map(i => i.json);\nconst task = (arr.find(i => i.data) || {}).data || {};\nlet out = (arr.find(i => i.output) || {}).output;\n\nif (typeof out === 'string') { try { out = JSON.parse(out); } catch {} }\n\nreturn [{\n  title: String(out?.title || '').trim(),\n  start: `${task.date}T05:00`,\n  end:   `${task.date}T05:15`\n}];"
      },
