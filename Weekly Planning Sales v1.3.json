        "hasOutputParser": true,
        "options": {
          "systemMessage": "Return a short, human-readable title from the provided sanitized text. \nRules: ≤ 8 words.\nIf text is empty, use a generic action like \"Follow up task\".\nadd to the title \"- https://erpnext.biss.lv/app/todo/<name>\"\nRespond ONLY as JSON matching the required schema.\n\nReturn a short, human-readable title from the provided sanitized text.\nRules: ≤ 8 words.\nIf text is empty, use a generic action like \"Follow up task\".\nadd to the title \"- https://erpnext.biss.lv/app/todo/<name>\"\nRespond ONLY as JSON matching the required schema."
        }
      },
